# =============================================================================
# CELC Backend - Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your local values.
# NEVER commit your real `.env` file. It is gitignored.
#
# For production, source these values from a secrets manager
# (Azure Key Vault, AWS Secrets Manager, Doppler, etc.)
# =============================================================================

# Database connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=<your_db_password>
DB_DATABASE=CELC
DB_PORT=3306

# Prisma connection string
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:<your_db_password>@localhost:3306/CELC"

# JWT
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=<your_jwt_secret>

# Server
PORT=3001
